--Считаем Retention, тут признаюсь, не сам писал. Конструкция WITH пока не понятна
WITH
    -- День первого события (нулевой день)
    (SELECT toDate(min(event_time)) FROM user_events) AS day_0

SELECT
    countDistinctIf(user_id, toDate(event_time) = day_0) AS total_users_day_0,

    countDistinctIf(
        user_id,
        toDate(event_time) BETWEEN day_0 + 7 AND day_0 + 7
        AND user_id IN (
            SELECT DISTINCT user_id
            FROM user_events
            WHERE toDate(event_time) = day_0
        )
    ) AS returned_in_7_days,

    round(
        (returned_in_7_days / total_users_day_0) * 100,
        2
    ) AS retention_7d_percent

FROM user_events;

--Выводим аналитику по дням

SELECT
    event_date,
    event_type,
    uniqMerge(uniq_users) AS unique_users,
    sumMerge(total_points) AS total_spent,
    countMerge(total_actions) AS total_actions
FROM user_events_agg
GROUP BY event_date, event_type
ORDER BY event_date ASC;